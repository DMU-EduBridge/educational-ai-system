# Google Gemini API 설정
GOOGLE_API_KEY=your_google_api_key_here

# 모델 설정
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=1.0
GEMINI_MAX_TOKENS=20000

# 임베딩 모델 설정
EMBEDDING_MODEL=models/embedding-001

# RAG 설정
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
MAX_CONTEXT_LENGTH=3000
SIMILARITY_THRESHOLD=0.7

# 벡터 데이터베이스 설정
CHROMA_DB_PATH=./ai-services/data/vector_db
CHROMA_COLLECTION_NAME=textbook_embeddings

# PostgreSQL 데이터베이스 설정 (Docker Compose용)
POSTGRES_USER=eduai
POSTGRES_PASSWORD=eduai2025
POSTGRES_DB=educational_ai

# 데이터베이스 URL (로컬 개발용 - PostgreSQL 또는 SQLite)
# PostgreSQL (권장)
DATABASE_URL=postgresql://eduai:eduai2025@localhost:5432/educational_ai

# SQLite (대안)
# DATABASE_URL=sqlite:///./db/dev.db
# SQLITE_DB_PATH=./db/dev.db

# 문제 생성 설정
DEFAULT_QUESTION_COUNT=10
DEFAULT_DIFFICULTY_MIX=balanced

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=
DEBUG=false
VERBOSE=false

# 캐시 설정
ENABLE_CACHE=true
CACHE_DIR=./ai-services/data/cache

# 개발 모드
DEVELOPMENT_MODE=false

# Airflow 설정
AIRFLOW_SECRET_KEY=your_airflow_secret_key_here
AIRFLOW_HOME=./airflow